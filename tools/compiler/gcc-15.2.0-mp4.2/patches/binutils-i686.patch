+    targ_selvecs="i386_elf32_vec"
+    ;;
   i[3-7]86-*-elf* | i[3-7]86-*-rtems* | i[3-7]86-*-genode*)
     targ_defvec=i386_elf32_vec
     targ_selvecs="iamcu_elf32_vec i386_coff_vec"
diff --color -urN binutils-2.45/config.sub binutils-2.45-nuovo/config.sub
--- binutils-2.45/config.sub	2025-07-27 01:00:00.000000000 +0200
+++ binutils-2.45-nuovo/config.sub	2026-09-21 15:58:20.580777278 +0200
@@ -1722,6 +1722,9 @@
 			;;
 		esac
 		;;
+	miosix*)
+		os=miosix
+		;;
 	aout* | coff* | elf* | pe*)
 		# These are machine code file formats, not OSes
 		obj=$os
