+++ binutils-2.45-nuovo/bfd/config.bfd	2026-09-21 15:58:20.577885721 +0200
@@ -586,7 +586,10 @@
     targ_defvec=hppa_som_vec
     targ_selvecs=hppa_elf32_vec
     ;;
-
+  i[3-7]86-*-miosix*)
